.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.sec {
  font-size: 28rpx;
  font-weight: 700;
  color: #17211d;
  margin-bottom: 16rpx;
}

.sec-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.parts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.part {
  width: 22%;
  flex: none;
  height: 160rpx;
  border-radius: 20rpx;
  background: #f4f2ee;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
}

.part-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  pointer-events: none;
  background: #fff;
}

.part.on {
  background: #1e5c4a;
  color: #fff;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  background: #f4f2ee;
}

.chip.on {
  background: #e8f0ec;
  color: #1e5c4a;
}

.proj {
  border: 2rpx solid #e7e3dc;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.proj.on {
  border-color: #1e5c4a;
}

.proj-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.proj-name {
  font-size: 30rpx;
  font-weight: 700;
}

.price {
  color: #c0803a;
  font-size: 36rpx;
  font-weight: 700;
  font-family: ui-monospace, Menlo, monospace;
}

.proj-bot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.jade {
  color: #1e5c4a;
  font-size: 24rpx;
}

.btn.sm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
}

.note {
  background: #faf1e4;
  color: #a9752f;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  display: flex;
  gap: 12rpx;
}

.note-ico {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #c0803a;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.empty {
  color: #8b948f;
  text-align: center;
  padding: 24rpx;
}
