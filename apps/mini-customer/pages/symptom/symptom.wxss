.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.sec {
  font-size: 28rpx;
  font-weight: 700;
  color: #17211d;
  margin-bottom: 16rpx;
}

.sec-row {
  display: flex;
  justify-content: space-between;
}

.parts {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.part {
  flex: 1;
  height: 140rpx;
  border-radius: 20rpx;
  background: #f4f2ee;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 16rpx;
  font-size: 26rpx;
}

.part.on {
  background: #1e5c4a;
  color: #fff;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  background: #f4f2ee;
}

.chip.on {
  background: #e8f0ec;
  color: #1e5c4a;
}

.proj {
  border: 2rpx solid #e7e3dc;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.proj.on {
  border-color: #1e5c4a;
}

.proj-top {
  display: flex;
  justify-content: space-between;
}

.proj-name {
  font-size: 30rpx;
  font-weight: 700;
}

.price {
  color: #c0803a;
  font-size: 32rpx;
  font-weight: 700;
  font-family: ui-monospace, Menlo, monospace;
}

.jade {
  color: #1e5c4a;
  font-size: 24rpx;
  margin: 8rpx 0;
}

.btn.sm {
  display: inline-block;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  margin-top: 8rpx;
}

.note {
  background: #faf1e4;
  color: #a9752f;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.empty {
  color: #8b948f;
  text-align: center;
  padding: 24rpx;
}
