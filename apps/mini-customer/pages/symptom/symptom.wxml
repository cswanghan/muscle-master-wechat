<view class="page" id="c2-symptom">
  <view class="card">
    <view class="sec">按部位选</view>
    <view class="parts">
      <view
        wx:for="{{parts}}"
        wx:key="id"
        class="part {{selectedId===item.id?'on':''}}"
        hover-class="tap"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="pickSymptom"
      >
        <view class="part-box"></view>
        <view>{{item.name}}</view>
      </view>
    </view>
    <view class="sec">按不适选</view>
    <view class="chips">
      <view
        wx:for="{{discomforts}}"
        wx:key="id"
        class="chip {{selectedId===item.id?'on':''}}"
        hover-class="tap"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="pickSymptom"
      >{{item.name}}</view>
    </view>
  </view>

  <view wx:if="{{selectedId}}" class="card">
    <view class="sec-row">
      <view class="sec">{{selectedName}} · 推荐项目</view>
      <view class="hint">{{projects.length}} 项</view>
    </view>
    <view wx:if="{{hint}}" id="empty-hint" class="empty">{{hint}}</view>
    <view
      wx:for="{{projects}}"
      wx:key="projectId"
      class="proj {{index===0?'on':''}}"
      hover-class="tap"
      data-id="{{item.projectId}}"
      bindtap="pickProject"
    >
      <view class="proj-top">
        <view class="proj-name">{{item.name}}</view>
        <view class="price">¥{{item.priceYuan}}</view>
      </view>
      <view class="hint">{{item.durationMinutes}} 分钟</view>
      <view class="proj-bot">
        <view class="jade">今晚可约</view>
        <view class="btn sm">选技师</view>
      </view>
    </view>
  </view>

  <view class="note">
    <view class="note-ico"></view>
    <view>选不准可先填写不适描述，到店由技师面诊后调整项目，差价按实际项目结算。</view>
  </view>
</view>
