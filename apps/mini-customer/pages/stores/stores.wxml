<view class="page">
  <view class="hero-t">选择门店</view>
  <view wx:if="{{projectName}}" class="hint">已选 {{projectName}}</view>
  <view wx:if="{{loading && !pickedStore}}" class="hint">加载中…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view
    wx:for="{{stores}}"
    wx:key="storeId"
    class="card store {{pickedStore.storeId===item.storeId?'on':''}}"
    hover-class="tap"
    data-id="{{item.storeId}}"
    bindtap="pickStore"
  >
    <image class="thumb" src="{{item.photo}}" mode="aspectFill" />
    <view class="grow">
      <view class="store-name">{{item.name}}</view>
      <view class="meta">{{item.businessStart || '10:00'}}–{{item.businessEnd || '22:00'}} <text wx:if="{{index===0}}" class="near">就近</text></view>
      <view class="jade">{{item.open === false ? '今日休息' : '今晚可约'}}</view>
    </view>
    <view class="btn ghost sm">预约</view>
  </view>

  <view wx:if="{{pickedStore && !projectId}}" class="sec">选择项目</view>
  <view
    wx:for="{{projects}}"
    wx:key="projectId"
    class="card proj"
    hover-class="tap"
    data-id="{{item.projectId}}"
    bindtap="pickProject"
  >
    <view class="proj-top">
      <view class="proj-name">{{item.name}}</view>
      <view class="price">¥{{item.priceYuan}}</view>
    </view>
    <view class="meta">{{item.durationMinutes}} 分钟</view>
    <view class="jade">今晚可约</view>
    <view class="btn sm">选时段</view>
  </view>
</view>
