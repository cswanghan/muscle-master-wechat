.hero-title {
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #1e5c4a;
  margin: 8rpx 0 24rpx;
}

.search {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  color: #8b948f;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-ico {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #c9cfcb;
  border-radius: 50%;
  flex-shrink: 0;
}

.sec-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.sec-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.sec-name {
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #17211d;
}

.sec-more {
  color: #8b948f;
  font-size: 24rpx;
}

.deal,
.store {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.store + .store,
.th + .th {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef2ef;
}

.thumb,
.avatar {
  width: 148rpx;
  height: 176rpx;
  border-radius: 20rpx;
  background: #edeae4;
  flex-shrink: 0;
  overflow: hidden;
  pointer-events: none;
}

.store-thumb {
  width: 176rpx;
  height: 128rpx;
  border-radius: 16rpx;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  padding-bottom: 0;
  align-items: center;
}

.grow {
  flex: 1;
  min-width: 0;
}

.deal-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.deal-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #17211d;
}

.price-col {
  text-align: right;
  flex-shrink: 0;
}

.price {
  color: #c0803a;
  font-size: 36rpx;
  font-weight: 700;
  font-family: ui-monospace, Menlo, monospace;
}

.strike {
  display: block;
  color: #b7b1a6;
  text-decoration: line-through;
  font-size: 22rpx;
}

.km {
  color: #8b948f;
  font-size: 22rpx;
}

.meta {
  color: #6b7a74;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.jade {
  color: #1e5c4a;
  font-size: 24rpx;
}

.km-line {
  color: #8b948f;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.sep {
  color: #e7e3dc;
  margin: 0 8rpx;
}

.store-bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.copper {
  color: #c0803a;
  font-weight: 600;
}

.deal-bot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.tag,
.chip,
.near,
.lvl {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #e8f0ec;
  color: #1e5c4a;
  margin-right: 8rpx;
}

.tag.copper {
  background: #fff;
  color: #a9752f;
  border: 1rpx solid #e0c49a;
}

.th-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.chips {
  margin-top: 10rpx;
}

.btn.sm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.btn.ghost.sm {
  background: #fff;
  border: 2rpx solid #1e5c4a;
  color: #1e5c4a;
}

.store {
  align-items: center;
}
