.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e5c4a;
  margin: 8rpx 0 24rpx;
}

.search {
  background: #fff;
  border-radius: 999rpx;
  padding: 22rpx 28rpx;
  color: #8b948f;
  font-size: 28rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid #e7e3dc;
}

.sec-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.sec-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sec-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #17211d;
}

.sec-more {
  color: #8b948f;
  font-size: 24rpx;
}

.deal,
.store {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.thumb,
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: repeating-linear-gradient(135deg, #efece6 0 10rpx, #f7f5f1 10rpx 20rpx);
  color: #b7b1a6;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar {
  border-radius: 50%;
}

.grow {
  flex: 1;
  min-width: 0;
}

.deal-name {
  font-size: 30rpx;
  font-weight: 600;
}

.price-row {
  margin-top: 6rpx;
}

.price {
  color: #c0803a;
  font-size: 36rpx;
  font-weight: 700;
  font-family: ui-monospace, Menlo, monospace;
}

.strike {
  margin-left: 8rpx;
  color: #8b948f;
  text-decoration: line-through;
  font-size: 24rpx;
}

.meta {
  color: #8b948f;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.jade {
  color: #1e5c4a;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.copper {
  color: #c0803a;
}

.tag,
.chip,
.near,
.lvl {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #e8f0ec;
  color: #1e5c4a;
  margin-right: 8rpx;
  margin-top: 8rpx;
}

.tag.copper {
  background: #faf1e4;
  color: #a9752f;
}

.btn.sm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  align-self: center;
}

.btn.ghost.sm {
  background: #fff;
  border: 2rpx solid #1e5c4a;
  color: #1e5c4a;
}
