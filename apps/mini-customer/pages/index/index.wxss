.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f4f1ea;
}

.mark {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #1e5c4a;
  color: #f4f1ea;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  color: #1e5c4a;
  font-weight: 600;
}

.hint {
  margin-top: 16rpx;
  color: #6b7a74;
  font-size: 24rpx;
}
