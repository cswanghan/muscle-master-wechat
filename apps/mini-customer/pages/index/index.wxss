.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 0 40rpx;
}

.mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #1e5c4a;
  color: #f4f1ea;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  color: #1e5c4a;
  font-weight: 600;
}

.entries {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #d7e6df;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.entry-ico {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #e8f0ec;
  color: #1e5c4a;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e5c4a;
}

.entry-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7a74;
}

.promo {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: repeating-linear-gradient(135deg, #faf1e4 0 12rpx, #f4f1ea 12rpx 24rpx);
  border: 2rpx dashed #d4b07a;
}

.promo-tag {
  display: inline-block;
  background: #faf1e4;
  color: #a9752f;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.promo-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #a9752f;
  font-weight: 600;
}

.promo-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b7a5c;
}
