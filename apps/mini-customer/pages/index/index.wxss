.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  background: #f4f1ea;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #1e5c4a;
  color: #f4f1ea;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  color: #1e5c4a;
  font-weight: 600;
}

.hint {
  margin-top: 12rpx;
  color: #6b7a74;
  font-size: 24rpx;
}

.error {
  color: #b42318;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.store {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  border: 1rpx solid #d7e6df;
}

.store-name {
  font-size: 32rpx;
  color: #1e5c4a;
  font-weight: 600;
}

.store-hours {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7a74;
}
