<view class="page">
  <view class="hero">
    <view class="mark">玉</view>
    <view class="title">{{title}}</view>
    <view class="hint">附近门店 · {{apiBase}}</view>
  </view>
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="list">
    <view class="store" wx:for="{{stores}}" wx:key="storeId">
      <view class="store-name">{{item.name}}</view>
      <view class="store-hours">{{item.businessStart}}–{{item.businessEnd}}</view>
    </view>
  </view>
</view>
