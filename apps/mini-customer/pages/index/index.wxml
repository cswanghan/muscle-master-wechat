<view class="page" id="c1-home">
  <view class="hero-title">疲劳酸痛，到肌松大师</view>
  <view class="search" id="entry-symptom" hover-class="tap" bindtap="goSymptom">
    <view class="search-ico"></view>
    <text>说说哪里不舒服，为你找师傅</text>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="sec-card">
    <view class="sec-row">
      <view class="sec-name">特惠预约</view>
      <view class="sec-more" hover-class="tap" bindtap="goMall">更多活动 ›</view>
    </view>
    <view wx:if="{{deal}}" class="deal" hover-class="tap" bindtap="goDeal">
      <view class="thumb deal-thumb">技师照</view>
      <view class="grow">
        <view class="deal-top">
          <view class="deal-name">{{deal.name}}</view>
          <view class="price-col">
            <text class="price">¥{{deal.priceYuan}}</text>
            <text class="strike">{{deal.strikeYuan}}</text>
          </view>
        </view>
        <view class="meta">{{deal.therapistName}} <text class="sep">|</text> 今天 19:30–20:30</view>
        <view class="km-line">4.0km · {{nearStore}}</view>
        <view class="deal-bot">
          <text class="tag copper">9.5折 · 仅此1档</text>
          <view class="btn sm" id="entry-deal" hover-class="tap" catchtap="goDeal">立即抢约</view>
        </view>
      </view>
    </view>
  </view>

  <view class="sec-card">
    <view class="sec-row">
      <view class="sec-name">门店预约</view>
      <view class="sec-more" id="entry-store" hover-class="tap" bindtap="goStores">更多门店 ›</view>
    </view>
    <view
      wx:for="{{stores}}"
      wx:key="storeId"
      class="store"
      hover-class="tap"
      data-id="{{item.storeId}}"
      bindtap="goStore"
    >
      <view class="thumb store-thumb">门店实拍</view>
      <view class="grow">
        <view class="deal-top">
          <view class="deal-name">{{item.name}}</view>
          <view class="km">{{index===0?'4.0km':'7.3km'}}</view>
        </view>
        <view class="meta">{{item.businessStart || '10:00'}}–{{item.businessEnd || '22:00'}} <text wx:if="{{index===0}}" class="near">就近</text></view>
        <view class="store-bot">
          <view class="jade">{{index===0?'今晚余 6 档':'今晚已满 · 可约明天'}}</view>
          <view class="btn ghost sm" hover-class="tap" data-id="{{item.storeId}}" catchtap="goStore">预约</view>
        </view>
      </view>
    </view>
  </view>

  <view class="sec-card">
    <view class="sec-row">
      <view class="sec-name">推拿师预约</view>
      <view class="sec-more" id="entry-therapist" hover-class="tap" bindtap="goSymptom">按症状找 ›</view>
    </view>
    <view
      wx:for="{{therapists}}"
      wx:key="therapistId"
      class="store th"
      hover-class="tap"
      data-id="{{item.therapistId}}"
      bindtap="goTherapist"
    >
      <view class="avatar"></view>
      <view class="grow">
        <view class="th-line">
          <text class="deal-name">{{item.name}}</text>
          <text class="lvl">{{item.levelLabel}}</text>
          <text class="copper">{{item.rating}}</text>
        </view>
        <view class="chips">
          <text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" class="chip">{{tg}}</text>
        </view>
      </view>
      <view class="btn ghost sm" hover-class="tap" data-id="{{item.therapistId}}" catchtap="goTherapist">预约</view>
    </view>
  </view>

  <view class="dock">
    <view class="dock-item on">
      <view class="ico ico-book"></view>
      <view>预约</view>
    </view>
    <view class="dock-item" hover-class="tap" bindtap="goMall">
      <view class="ico ico-gift"></view>
      <view>好礼</view>
    </view>
    <view class="dock-item" hover-class="tap" bindtap="goMine">
      <view class="ico ico-me"></view>
      <view>我的</view>
    </view>
  </view>
</view>
