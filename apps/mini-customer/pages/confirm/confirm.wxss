.ticker {
  background: #faf1e4;
  color: #a9752f;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.ticker.ok {
  background: #e8f0ec;
  color: #1e5c4a;
}

.ticker.dead {
  background: #f8e4e2;
  color: #b42318;
}

.summary {
  margin-bottom: 32rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.k {
  color: #6b7a74;
}

.price-row {
  border-top: 1rpx solid #d7e6df;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.price {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e5c4a;
}

.btn {
  margin-bottom: 20rpx;
}
