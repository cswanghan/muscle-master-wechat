.ticker {
  background: #faf1e4;
  color: #a9752f;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.ticker.ok {
  background: #e8f0ec;
  color: #1e5c4a;
}

.ticker.dead {
  background: #f8e4e2;
  color: #b42318;
}

.summary {
  margin-bottom: 32rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.k {
  color: #6b7a74;
}

.price-row {
  border-top: 1rpx solid #d7e6df;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.price,
.bar-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #c0803a;
  font-family: ui-monospace, Menlo, monospace;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
}

.head-card {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: repeating-linear-gradient(135deg, #efece6 0 10rpx, #f7f5f1 10rpx 20rpx);
}

.jade { color: #1e5c4a; }

.coupon {
  padding: 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e7e3dc;
  margin-bottom: 12rpx;
}

.coupon.on { border-color: #1e5c4a; }
.coupon.off { color: #8b948f; }
.warn { color: #b3452f; font-size: 22rpx; margin-left: 8rpx; }

.pay-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2ef;
}

.pay-row.on { color: #1e5c4a; font-weight: 600; }
.pay-row.off { color: #8b948f; }

.sec {
  font-weight: 700;
  margin-bottom: 12rpx;
}

.pay {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #e8f0ec;
  color: #1e5c4a;
}

.paybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx 28rpx;
  border-top: 1rpx solid #e7e3dc;
}

.paybar .btn {
  width: 260rpx;
  margin: 0;
}

.ghost {
  text-align: center;
  color: #8b948f;
  margin-top: 16rpx;
  margin-bottom: 160rpx;
}

.mono {
  font-family: ui-monospace, Menlo, monospace;
}

.page {
  padding-bottom: 180rpx;
}
