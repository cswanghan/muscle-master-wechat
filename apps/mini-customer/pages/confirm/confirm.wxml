<view class="page" id="c4-confirm">
  <view wx:if="{{pending && !expired}}" class="ticker" id="countdown">
    时段已为你锁定，请在 <text class="mono">{{remain}}</text> 内完成支付
  </view>
  <view wx:if="{{pending && expired}}" class="ticker dead">锁已过期，请返回重选时段</view>
  <view wx:if="{{closed}}" class="ticker dead" id="closed-banner">预约已取消</view>
  <view wx:if="{{paid}}" class="ticker ok">支付成功 · 订单已预约</view>

  <view class="card head-card">
    <view class="avatar"></view>
    <view class="grow">
      <view class="title">{{projectName}}</view>
      <view class="hint">{{therapistName}} · 指定加成 ¥0</view>
    </view>
  </view>
  <view class="card">
    <view class="row"><text class="k">到店时间</text><text class="mono">{{date}} {{start}}</text></view>
    <view class="row"><text class="k">门店</text><text>{{storeName}}</text></view>
    <view class="row"><text class="k">房间</text><text>到店由前台分配</text></view>
    <view class="row"><text class="k">主诉备注</text><text class="jade">填写 ›</text></view>
  </view>

  <view class="card">
    <view class="sec">优惠</view>
    <view class="coupon on">
      <view class="dot on">✓</view>
      <view class="grow">
        <view>新客体验券 ¥20</view>
        <view class="hint">周一至周五 10:00–17:00 可用</view>
      </view>
      <text class="off-amt">-20</text>
    </view>
    <view class="coupon off">
      <view class="dot"></view>
      <view class="grow">
        <view>满 300 减 50</view>
        <view class="warn">未满门槛，还差 ¥101</view>
      </view>
    </view>
    <view class="pay-row">
      <text class="k">9.5 折时段优惠</text>
      <text class="off-amt">-{{discountYuan}}</text>
    </view>
  </view>

  <view class="card">
    <view class="sec">支付方式</view>
    <view class="pay-row off">
      <view class="dot"></view>
      <text class="grow">储值余额 ¥0.00</text>
      <text class="jade">去充值</text>
    </view>
    <view class="pay-row off">
      <view class="dot"></view>
      <text class="grow">礼卡余额 ¥200.00</text>
    </view>
    <view class="pay-row on">
      <view class="dot on">✓</view>
      <text class="grow">微信支付</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="paybar">
    <view>
      <view class="bar-price">¥{{priceYuan}}</view>
      <view class="hint">锁定 15 分钟</view>
    </view>
    <view wx:if="{{!orderId && !paid && !closed}}" class="btn" id="lock-btn" hover-class="tap" bindtap="lockOrder">确认预约</view>
    <view wx:if="{{pending && !expired}}" class="btn" id="pay-btn" hover-class="tap" bindtap="lockAndPay">立即支付</view>
    <view wx:if="{{paid || closed}}" class="btn" hover-class="tap" bindtap="goMine">查看订单</view>
  </view>
  <view wx:if="{{pending}}" class="ghost" bindtap="cancelOrder">取消预约</view>
</view>
