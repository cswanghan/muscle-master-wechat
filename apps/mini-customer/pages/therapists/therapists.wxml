<view class="page">
  <view class="hero-t">选择推拿师</view>
  <view class="hint">林晓 / 陈默 / 周可 · 点卡片进选时段</view>
  <view wx:if="{{loading && !picked}}" class="hint">加载中…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view
    wx:for="{{therapists}}"
    wx:key="therapistId"
    class="card th {{picked.therapistId===item.therapistId?'on':''}}"
    hover-class="tap"
    data-id="{{item.therapistId}}"
    bindtap="pickTherapist"
  >
    <view class="avatar"></view>
    <view class="grow">
      <view class="th-name">{{item.name}} <text class="lvl">{{item.levelLabel}}</text></view>
      <view class="copper">{{item.rating}} 分</view>
      <view class="meta">{{item.intro || '手法稳、力度可调'}}</view>
    </view>
    <view class="btn ghost sm">预约</view>
  </view>

  <view wx:if="{{picked}}" class="sec">{{picked.name}} · 可做项目</view>
  <view
    wx:for="{{projects}}"
    wx:key="projectId"
    class="card proj"
    hover-class="tap"
    data-id="{{item.projectId}}"
    bindtap="pickProject"
  >
    <view class="proj-top">
      <view class="proj-name">{{item.name}}</view>
      <view class="price">¥{{item.priceYuan}}</view>
    </view>
    <view class="meta">{{item.durationMinutes}} 分钟</view>
    <view class="btn sm">选时段</view>
  </view>
</view>
