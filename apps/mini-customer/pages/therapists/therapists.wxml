<view class="page">
  <view wx:if="{{loading && !picked}}" class="hint">加载中…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="list">
    <view
      wx:for="{{therapists}}"
      wx:key="therapistId"
      class="card th {{picked.therapistId===item.therapistId?'on':''}}"
      data-item="{{item}}"
      bindtap="pickTherapist"
    >
      <view class="th-head">
        <text class="th-name">{{item.name}}</text>
        <text class="{{item.levelClass}}">{{item.levelLabel}}</text>
        <text wx:if="{{item.newcomer}}" class="lv-new">新技师</text>
      </view>
      <view class="hint">{{item.rating}} · {{item.intro}}</view>
      <view wx:if="{{item.rateText}}" class="stat-row">
        <text class="stat-key">{{item.rateText}}</text>
        <text class="stat-sub">好评率 · {{item.reviewText}}</text>
      </view>
      <view wx:else class="stat-row">
        <text class="stat-sub">{{item.reviewText}}</text>
      </view>
      <view wx:if="{{item.repeatText}}" class="stat-repeat">{{item.repeatText}}</view>
    </view>
  </view>
  <view wx:if="{{picked}}" class="sec">选择项目</view>
  <view class="list">
    <view
      wx:for="{{projects}}"
      wx:key="projectId"
      class="card proj"
      data-item="{{item}}"
      bindtap="pickProject"
    >
      <view class="proj-name">{{item.name}}</view>
      <view class="hint">{{item.durationMinutes}}+{{item.bufferMinutes}} 分钟</view>
      <view class="price">¥{{item.priceYuan}}</view>
    </view>
  </view>
</view>
