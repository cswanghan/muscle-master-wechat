<view class="page staff-page">
  <view class="bar">
    <view>
      <view class="title">门店排班</view>
      <view class="sub">{{date}} · 只读对照</view>
    </view>
  </view>
  <view wx:if="{{error}}" class="err">{{error}}</view>
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:for="{{rows}}" wx:key="therapistId" class="card">
    <view class="name">{{item.name}} <text class="lvl">{{item.level}}</text></view>
    <view class="slots">
      <view wx:for="{{item.chips}}" wx:for-item="c" wx:key="key" class="chip {{c.tone}}">
        <view class="chip-t">{{c.time}}</view>
        <view class="chip-s">{{c.label}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{!loading && !rows.length}}" class="empty">今日暂无排班</view>
  <view class="dock">
    <view class="dock-item" bindtap="goToday">
      <view class="ico"></view>
      <view>工作台</view>
    </view>
    <view class="dock-item on">
      <view class="ico"></view>
      <view>排班</view>
    </view>
    <view class="dock-item" bindtap="goPerf">
      <view class="ico"></view>
      <view>业绩</view>
    </view>
    <view class="dock-item" bindtap="goMine">
      <view class="ico"></view>
      <view>我的</view>
    </view>
  </view>
</view>
