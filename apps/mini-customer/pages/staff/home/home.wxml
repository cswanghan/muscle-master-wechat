<view class="page staff-page">
  <view class="hero">
    <view class="mark">松</view>
    <view class="title">肌松大师 · 员工端</view>
    <view class="hint">技师工作台 / 前台收银 / 店长审批</view>
  </view>
  <view class="hint">按顾客预约的那位技师进，工作台只显示本人的单</view>
  <view wx:if="{{error}}" class="hint">{{error}}</view>
  <navigator
    wx:for="{{therapists}}"
    wx:key="who"
    url="/pages/staff/today/today?who={{item.who}}"
    class="go"
  >技师 · {{item.name}}（{{item.levelLabel}}）</navigator>
  <navigator url="/pages/staff/frontdesk/frontdesk" class="go">前台 · 核销与收银</navigator>
  <navigator url="/pages/staff/manager/manager" class="go">店长 · 经营概览</navigator>
  <navigator url="/pages/staff/schedule/schedule" class="go ghost">门店排班（只读）</navigator>
</view>
