.page {
  min-height: 100vh;
  background: #f4f2ee;
  padding: 24rpx 24rpx 180rpx;
  font-size: 30rpx;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.sec {
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 600;
}

.sec-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.hint {
  color: #8b948f;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 16rpx;
}

.pills {
  display: flex;
  gap: 18rpx;
}

.pill {
  flex: 1;
  background: #f8f7f4;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
}

.pill.on {
  background: #1e5c4a;
  color: #fff;
}

.pill .t {
  font-size: 30rpx;
  font-weight: 600;
  font-family: ui-monospace, Menlo, monospace;
}

.pill .s {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.pill.num {
  font-size: 32rpx;
  font-weight: 600;
  font-family: ui-monospace, Menlo, monospace;
  padding: 28rpx 0;
}

.box {
  margin-top: 24rpx;
  background: #f8f7f4;
  border-radius: 20rpx;
  padding: 26rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.row.mute {
  color: #8b948f;
}

.copper {
  color: #c0803a;
  font-weight: 600;
  font-family: ui-monospace, Menlo, monospace;
}

.share {
  display: flex;
  gap: 20rpx;
  border: 1rpx solid #edeae4;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 20rpx 0 8rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: repeating-linear-gradient(45deg, #edeae4 0 12rpx, #f7f5f1 12rpx 24rpx);
  flex-shrink: 0;
}

.share-t {
  font-weight: 600;
}

.warn {
  margin-top: 8rpx;
  color: #b3452f;
  font-size: 22rpx;
}

.grow { flex: 1; }

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #edeae4;
  padding: 28rpx 32rpx 48rpx;
  display: flex;
  gap: 20rpx;
}

.ghost {
  border: 2rpx solid #e7e3dc;
  color: #4a544f;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  font-size: 30rpx;
}

.btn {
  flex: 1;
  background: #1e5c4a;
  color: #fff;
  border-radius: 24rpx;
  text-align: center;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: 600;
}
