/* 正文最小 30rpx(15px)，与店长台同一套无障碍下限。 */
.page {
  padding: 20rpx 0 170rpx;
}

.card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
}

.segs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #f4f2ee;
  color: #17211d;
  font-size: 30rpx;
}

.seg.on {
  background: #1e5c4a;
  color: #fff;
}

.sum {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0ede8;
}

.grow { flex: 1; min-width: 0; }

.cap {
  font-size: 30rpx;
  color: #8b948f;
}

.total {
  font-size: 72rpx;
  font-weight: 700;
  color: #17211d;
  line-height: 1.2;
}

.clock { text-align: right; }

.clock-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #17211d;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: #17211d;
}

.minus { color: #b3261e; }

.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.sec-hint {
  font-size: 30rpx;
  font-weight: 400;
  color: #8b948f;
}

.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0ede8;
  min-height: 96rpx;
}

.item-t { font-size: 30rpx; color: #17211d; }
.item-m { font-size: 30rpx; color: #8b948f; margin-top: 4rpx; }
.item-a { font-size: 32rpx; font-weight: 600; color: #17211d; }

.appeal-card { display: flex; align-items: center; gap: 16rpx; }

.btn.ghost {
  min-width: 96rpx;
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid #1e5c4a;
  color: #1e5c4a;
  font-size: 30rpx;
  text-align: center;
}

.hint { padding: 20rpx 0; color: #8b948f; font-size: 30rpx; }

.err {
  margin: 16rpx 0;
  padding: 16rpx;
  background: #fdecea;
  border-radius: 12rpx;
  color: #b3261e;
  font-size: 30rpx;
}
