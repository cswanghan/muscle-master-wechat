<view class="page staff-page" id="t4-perf">
  <view class="card">
    <view class="segs">
      <view
        wx:for="{{ranges}}"
        wx:key="key"
        class="seg {{range === item.key ? 'on' : ''}}"
        data-v="{{item.key}}"
        bindtap="pick"
      >{{item.label}}</view>
    </view>

    <view class="sum">
      <view class="grow">
        <view class="cap">{{rangeLabel}}累计提成</view>
        <view class="total">¥{{total}}</view>
        <view class="cap" wx:if="{{level}}">{{level}} · 提成 {{rateText}} · {{from}} 起</view>
      </view>
      <view class="clock">
        <view class="cap">钟数</view>
        <view class="clock-num">{{clocks}}</view>
      </view>
    </view>

    <view wx:if="{{error}}" class="err">{{error}}</view>
    <view wx:elif="{{loading}}" class="hint">加载中…</view>

    <view wx:for="{{rows}}" wx:key="key" class="row">
      <view class="grow {{item.tone}}">{{item.label}}</view>
      <view class="{{item.tone}}">{{item.text}}</view>
    </view>
    <view wx:if="{{!loading && !rows.length && !error}}" class="hint">本期暂无提成</view>
  </view>

  <view class="card">
    <view class="sec">
      <text>明细</text>
      <text class="sec-hint">点条目下钻到单</text>
    </view>
    <view wx:if="{{!entries.length && !loading}}" class="hint">暂无记录</view>
    <view
      wx:for="{{entries}}"
      wx:key="orderId"
      class="item"
      data-id="{{item.orderId}}"
      hover-class="tap"
      bindtap="openOrder"
    >
      <view class="grow">
        <view class="item-t {{item.tone}}">{{item.title}}</view>
        <view class="item-m">{{item.meta}}</view>
      </view>
      <view class="item-a {{item.tone}}">{{item.amountText}}</view>
    </view>
  </view>

  <view class="card appeal-card">
    <view class="grow">
      <view class="item-t">数据有疑问？</view>
      <view class="item-m">提成 T+1 生成，昨日 04:00 前完成</view>
    </view>
    <view class="btn ghost" bindtap="appeal">申诉</view>
  </view>

  <view class="dock">
    <view class="dock-item" bindtap="goToday"><view class="ico"></view><view>工作台</view></view>
    <view class="dock-item" bindtap="goSchedule"><view class="ico"></view><view>排班</view></view>
    <view class="dock-item on"><view class="ico"></view><view>业绩</view></view>
    <view class="dock-item" bindtap="goMine"><view class="ico"></view><view>我的</view></view>
  </view>
</view>
