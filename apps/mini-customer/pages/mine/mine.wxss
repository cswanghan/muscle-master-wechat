.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.mark {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #1e5c4a;
  color: #f4f1ea;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e5c4a;
}

.sec {
  margin: 28rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e5c4a;
}

.order {
  margin-bottom: 16rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-no {
  font-family: ui-monospace, Menlo, monospace;
  font-size: 24rpx;
  color: #6b7a74;
}

.st {
  font-size: 22rpx;
  color: #a9752f;
  background: #faf1e4;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.st.muted {
  background: #e8f0ec;
  color: #1e5c4a;
}

.price {
  margin-top: 8rpx;
  font-weight: 700;
  color: #1e5c4a;
}

.empty {
  padding: 28rpx;
  text-align: center;
  color: #8b948f;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx dashed #c9cfcb;
}

.no-wallet {
  margin-top: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8b948f;
}

.ord-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.ord-btn {
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #1e5c4a;
  color: #f4f1ea;
}

/* 已评价是回看入口，不该和「去评价」抢同一份视觉权重 */
.ord-btn.done {
  background: #fff;
  color: #6b7a74;
  border: 1rpx solid #d7e6df;
  font-weight: 400;
}
