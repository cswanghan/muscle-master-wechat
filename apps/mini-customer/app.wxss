page {
  background-color: #f4f1ea;
  color: #1a1c1b;
  font-size: 28rpx;
  min-height: 100%;
}

.brand {
  color: #1e5c4a;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 160rpx;
  box-sizing: border-box;
}

.hint {
  color: #6b7a74;
  font-size: 24rpx;
}

.error {
  color: #b42318;
  font-size: 26rpx;
  margin: 16rpx 0;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #d7e6df;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #1e5c4a;
  color: #f4f1ea;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.ghost {
  background: #fff;
  color: #1e5c4a;
  border: 2rpx solid #1e5c4a;
}

.btn[disabled] {
  opacity: 0.45;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #faf8f3;
  border-top: 1rpx solid #d7e6df;
  display: flex;
  z-index: 20;
}

.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8b948f;
  font-size: 22rpx;
}

.dock-item.on {
  color: #1e5c4a;
  font-weight: 600;
}

.dock-ico {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e8f0ec;
  color: #1e5c4a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.dock-item.on .dock-ico {
  background: #1e5c4a;
  color: #f4f1ea;
}

/* 等级徽章：只用主色的明度分档，不引第二个色相 —— 四档要能一眼排序，不能变成四种彩色标签。 */
.lv {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.lv-junior {
  color: #6b7a74;
  border: 1rpx solid #d7e6df;
  background: transparent;
}

.lv-middle {
  color: #2f6b58;
  background: #e8f0ec;
}

.lv-senior {
  color: #f4f1ea;
  background: #2f6b58;
}

.lv-chief {
  color: #f4f1ea;
  background: #1e5c4a;
  box-shadow: inset 0 0 0 2rpx #c8a24a;
}

/* 新技师：把「没有数据」说清楚，别让空白被读成差。 */
.lv-new {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #8a6d1f;
  background: #f7f0dc;
}

/* 技师统计：好评率是选择时的主信号，放大；回头是佐证，压小。 */
.stat-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 10rpx;
}

.stat-key {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e5c4a;
  font-variant-numeric: tabular-nums;
}

.stat-sub {
  font-size: 22rpx;
  color: #6b7a74;
}

.stat-repeat {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7a74;
  font-variant-numeric: tabular-nums;
}
