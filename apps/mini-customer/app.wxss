page {
  background-color: #f4f2ee;
  color: #17211d;
  font-size: 28rpx;
  min-height: 100%;
}

.brand {
  color: #1e5c4a;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 160rpx;
  box-sizing: border-box;
}

.hint {
  color: #6b7a74;
  font-size: 24rpx;
}

.error {
  color: #b42318;
  font-size: 26rpx;
  margin: 16rpx 0;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #d7e6df;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #1e5c4a;
  color: #f4f1ea;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.ghost {
  background: #fff;
  color: #1e5c4a;
  border: 2rpx solid #1e5c4a;
}

.btn[disabled] {
  opacity: 0.45;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #edeae4;
  display: flex;
  padding: 18rpx 0 44rpx;
  z-index: 20;
}

.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8b948f;
  font-size: 22rpx;
}

.dock-item.on {
  color: #1e5c4a;
  font-weight: 500;
}

.dock-svg,
.dock image {
  width: 44rpx !important;
  height: 44rpx !important;
  display: block;
  flex-shrink: 0;
  overflow: hidden;
  pointer-events: none;
}

.ico {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  flex-shrink: 0;
  pointer-events: none;
}

.ico-book {
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.ico-book::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 12rpx;
  height: 3rpx;
  background: currentColor;
}
.ico-book::after {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 22rpx;
  width: 10rpx;
  height: 6rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

.ico-gift {
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  height: 34rpx;
}
.ico-gift::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -10rpx;
  width: 3rpx;
  height: 44rpx;
  background: currentColor;
  transform: translateX(-50%);
}
.ico-gift::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 8rpx;
  height: 3rpx;
  background: currentColor;
}

.ico-me {
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  width: 20rpx;
  height: 20rpx;
  margin: 0 auto 22rpx;
}
.ico-me::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 22rpx;
  width: 36rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.tap {
  opacity: 0.65;
}

.dock-ico {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: transparent;
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

/*
 * Staff screens were a separate mini program with its own app.wxss. Merging
 * them in meant they inherited the customer definitions of .ico, .dock,
 * .dock-item and the base font size — and the customer .ico is only a
 * positioning box whose glyph comes from .ico-book/.ico-gift/.ico-me, so every
 * staff dock icon rendered blank. These restore what the staff app had, scoped
 * to .staff-page on the page root so the customer screens are untouched.
 */
.staff-page {
  font-size: 30rpx;
}

.staff-page .ico {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  pointer-events: none;
}

.staff-page .dock {
  padding: 20rpx 0 44rpx;
}

.staff-page .dock-item {
  font-size: 24rpx;
}
