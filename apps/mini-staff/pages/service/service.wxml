<view class="page">
  <view class="hero">
    <view class="hero-kicker">服务进行中 · {{next.roomName || '待分房'}}</view>
    <view class="timer">{{timerText}}</view>
    <view class="hero-sub">{{next.customerName || '当前客人'}} · {{next.projectName || '到店项目'}}</view>
    <view class="hero-acts">
      <view class="btn outline" bindtap="askAddon">申请加钟</view>
      <view
        wx:if="{{status !== 'IN_SERVICE' && status !== 'COMPLETED'}}"
        class="btn solid {{busy ? 'off' : ''}}"
        bindtap="startService"
      >开始服务</view>
      <view
        wx:else
        class="btn solid {{busy || status !== 'IN_SERVICE' ? 'off' : ''}}"
        bindtap="completeService"
      >结束服务</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="card">
    <view class="sec-row">
      <view class="sec">理疗记录</view>
      <view class="hint">提交后不可删除</view>
    </view>

    <view class="field">主诉</view>
    <textarea
      class="box"
      maxlength="500"
      placeholder="右侧颈肩僵硬，转头受限…"
      value="{{chief}}"
      bindinput="onChief"
    />

    <view class="field">手法</view>
    <view class="chips">
      <view
        wx:for="{{methods}}"
        wx:key="id"
        class="chip {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="toggleMethod"
      >{{item.name}}</view>
    </view>

    <view class="field">力度</view>
    <view class="chips three">
      <view
        wx:for="{{forces}}"
        wx:key="id"
        class="chip force {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="pickForce"
      >{{item.name}}</view>
    </view>

    <view class="field">禁忌与提醒</view>
    <view class="warn">
      <textarea
        class="warn-box"
        maxlength="300"
        placeholder="高血压，避免颈部快速扳动…"
        value="{{caution}}"
        bindinput="onCaution"
      />
    </view>

    <view class="consent" bindtap="toggleConsent">
      <view class="check {{consented ? 'on' : ''}}">{{consented ? '✓' : ''}}</view>
      <view>已向客户口头告知本次记录内容</view>
    </view>
  </view>

  <view wx:if="{{notes.length}}" class="card">
    <view class="sec">已提交记录</view>
    <view wx:for="{{notes}}" wx:key="id" class="note">
      <view class="note-t">{{item.createdAt}}</view>
      <view class="note-c">{{item.content}}</view>
    </view>
  </view>

  <view class="bottom">
    <view class="btn submit {{busy ? 'off' : ''}}" bindtap="submitAndClose">提交记录并结单</view>
  </view>
</view>
