.desk {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: #f4f1ea;
  box-sizing: border-box;
}

.bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1e5c4a;
}

.sub,
.meta {
  font-size: 30rpx;
  color: #4a5a54;
}

.grid {
  display: flex;
  gap: 24rpx;
}

.card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1px solid #d7e6df;
}

.h2 {
  font-size: 34rpx;
  color: #1e5c4a;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.field {
  height: 96rpx;
  border: 1px solid #d7e6df;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  background: #f8faf9;
}

.btn {
  height: 96rpx;
  line-height: 96rpx;
  background: #1e5c4a;
  color: #f4f1ea;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 0 28rpx;
  margin: 0;
}

.btn.ghost {
  background: #e8f1ed;
  color: #1e5c4a;
  margin-bottom: 16rpx;
}

.hit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1px solid #e8f1ed;
}

.strong {
  font-size: 32rpx;
  font-weight: 600;
}

.channels {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.chip {
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: #e8f1ed;
  color: #1e5c4a;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.chip.on {
  background: #1e5c4a;
  color: #fff;
}

.ok {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #e8f1ed;
  color: #1e5c4a;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.err {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #fdecea;
  color: #8a2418;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.qr {
  width: 280rpx;
  height: 280rpx;
  margin: 16rpx auto;
  border: 8rpx solid #1e5c4a;
  background: repeating-conic-gradient(#14352c 0% 25%, #fff 0% 50%) 50% / 28rpx 28rpx;
}

.qr-canvas {
  width: 280rpx;
  height: 280rpx;
  margin: 16rpx auto;
  background: #fff;
}
