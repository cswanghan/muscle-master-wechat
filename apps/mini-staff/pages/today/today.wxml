<view class="page">
  <view class="hero">
    <view class="hero-kicker">T1 · 技师工作台</view>
    <view class="hero-title">{{staffName || '今日下一单'}}</view>
    <view class="hero-sub">三秒看懂谁 / 几点 / 哪张床</view>
  </view>

  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{next}}" class="card" bindtap="openService">
    <view class="card-top">
      <text class="who">{{next.customerName}}</text>
      <text wx:if="{{next.isNewCustomer}}" class="badge">新客</text>
    </view>
    <view class="when">{{next.start}}–{{next.end}}</view>
    <view class="meta">{{next.roomName}} · {{next.bedName}}</view>
    <view class="meta">{{next.projectName}}</view>
    <view class="eta">{{etaText}}</view>
    <view class="tap">进入服务页</view>
  </view>

  <view wx:elif="{{!loading && !error}}" class="empty">
    <view class="empty-title">暂无下一单</view>
    <view class="hint">今天没有待服务预约</view>
  </view>

  <view class="section-title">今日时间轴</view>
  <view class="timeline">
    <view wx:for="{{chips}}" wx:key="slotNo" class="chip {{item.tone}}">
      <text class="chip-t">{{item.label}}</text>
      <text class="chip-s">{{item.state}}</text>
    </view>
  </view>
</view>
