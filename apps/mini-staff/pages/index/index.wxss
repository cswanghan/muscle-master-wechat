.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f4f1ea;
  padding: 48rpx;
}

.mark {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #1e5c4a;
  color: #f4f1ea;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  color: #1e5c4a;
  font-weight: 600;
}

.hint {
  margin-top: 16rpx;
  color: #6b7a74;
  font-size: 24rpx;
  text-align: center;
}

.roles {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

.role {
  min-width: 96rpx;
  height: 96rpx;
  padding: 0 24rpx;
  line-height: 96rpx;
  text-align: center;
  background: #1e5c4a;
  color: #f4f1ea;
  border-radius: 12rpx;
  font-size: 28rpx;
}
