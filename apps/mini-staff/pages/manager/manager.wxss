/* 750rpx 设计宽 → 2rpx = 1px。正文最小 30rpx(15px)，主操作 96rpx(48px)。 */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: #f4f1ea;
  box-sizing: border-box;
}

.bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1e5c4a;
}

.sub {
  font-size: 30rpx;
  color: #4a5a54;
}

.rate {
  text-align: right;
}

.rate-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1e5c4a;
  line-height: 1.1;
}

.rate-cap {
  font-size: 30rpx;
  color: #4a5a54;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1px solid #d7e6df;
  margin-bottom: 24rpx;
}

.h2 {
  font-size: 34rpx;
  color: #1e5c4a;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty {
  font-size: 30rpx;
  color: #7d8b85;
  padding: 24rpx 0;
}

/* ---- 分时满班率 ---- */
.chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.col {
  flex: 0 0 auto;
  min-width: 68rpx;
  text-align: center;
}

.track {
  height: 220rpx;
  display: flex;
  align-items: flex-end;
  background: #f1f6f4;
  border-radius: 8rpx;
  overflow: hidden;
}

.fill {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
}

.fill.full {
  background: #1e5c4a;
}

.fill.busy {
  background: #4f9a80;
}

.fill.idle {
  background: #a9cdbf;
}

.fill.rest {
  background: #dfe7e3;
}

.col-text,
.col-hour {
  font-size: 30rpx;
  color: #4a5a54;
  padding: 6rpx 0;
}

.legend {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #4a5a54;
}

.dot {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  margin: 0 8rpx 0 16rpx;
}

.dot.full {
  background: #1e5c4a;
}

.dot.busy {
  background: #4f9a80;
}

.dot.idle {
  background: #a9cdbf;
}

.lg {
  font-size: 30rpx;
  margin-right: 8rpx;
}

/* ---- 待办 ---- */
.group {
  margin-top: 8rpx;
}

.group-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e5c4a;
  padding: 16rpx 0 8rpx;
}

/* 标题独占一行、按钮另起一行右对齐：异常单有三个动作，挤在同一行会把标题吃掉。 */
.task {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  padding: 16rpx 0;
  border-top: 1px solid #e8f1ed;
}

.task-main {
  flex: 1 1 100%;
  min-width: 0;
}

/* 单行省略：雪花 ID 很长，换行会把按钮挤走，店长扫一眼要的是"哪类 + 哪单"。 */
.task-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #14352c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  font-size: 30rpx;
  color: #7d8b85;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acts {
  display: flex;
  gap: 12rpx;
  width: 100%;
  justify-content: flex-end;
}

.btn {
  min-width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 24rpx;
  background: #1e5c4a;
  color: #f4f1ea;
  font-size: 30rpx;
  border-radius: 12rpx;
  text-align: center;
}

.btn.ghost {
  background: #e8f1ed;
  color: #1e5c4a;
}

.btn.off {
  opacity: 0.45;
}

.tag {
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #7d8b85;
}

.ok {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #e8f1ed;
  color: #1e5c4a;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.err {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #fdecea;
  color: #8a2418;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.ruler {
  font-size: 30rpx;
  color: #7d8b85;
  text-align: center;
  padding: 16rpx 0;
}
