page {
  background-color: #f4f2ee;
  color: #17211d;
  font-size: 30rpx;
  min-height: 100%;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #edeae4;
  display: flex;
  padding: 20rpx 0 44rpx;
  z-index: 20;
}

.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8b948f;
  font-size: 24rpx;
}

.dock-item.on {
  color: #1e5c4a;
  font-weight: 500;
}

.dock-svg {
  width: 44rpx;
  height: 44rpx;
}

.brand {
  color: #1e5c4a;
}
